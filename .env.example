OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# No EMBEDDING_MODEL var: fixed to all-MiniLM-L6-v2 via chromadb's bundled ONNX
# runtime (app/ingest.py) - not configurable, so nothing to set here.
CHROMA_PERSIST_DIR=./chroma_db

# MCP_TRANSPORT=inmemory runs the MCP tools inside this process instead of spawning
# mcp/server.py as a subprocess (saves a second process's memory - Render's deploy
# sets this; see render.yaml). Leave unset for local dev: default "stdio" is the real
# subprocess, which is what you want to see/debug locally and what every test uses.
# Host/port for `uvicorn app.main:app` are CLI flags, not env vars.
